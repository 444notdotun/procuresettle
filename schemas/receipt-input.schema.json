{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/starboytiimz/procuresettle/schemas/receipt-input.schema.json",
  "title": "ProcureSettle receipt submission input",
  "description": "Receipt quantities submitted against a purchase order. The contract bounds the quantity array to MAX_LINES (8) entries.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receipt_id",
    "quantities"
  ],
  "properties": {
    "receipt_id": {
      "type": "integer",
      "minimum": 1,
      "description": "Caller-assigned receipt identifier, unique within the purchase order."
    },
    "quantities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/receiptQuantityInput"
      }
    }
  },
  "$defs": {
    "receiptQuantityInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "line_id",
        "quantity_delta"
      ],
      "properties": {
        "line_id": {
          "type": "integer",
          "minimum": 1,
          "description": "Existing purchase-order line identifier."
        },
        "quantity_delta": {
          "type": "integer",
          "minimum": 1,
          "description": "Positive quantity asserted for this receipt line."
        }
      }
    }
  }
}
